{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@lemonade/gui",
  "version": "1.0.0",
  "description": "The Lemonade GUI — paint, blocks, i18n, API, UX, and AI in one app.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Lemonade",
    "email": "hello@lemonade.app",
    "url": "https://lemonade.app"
  },
  "contributors": [
    "Lemonade Team <team@lemonade.app>"
  ],
  "homepage": "https://github.com/Lemonade-app/lemon-gui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lemonade-app/lemon-gui.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/Lemonade-app/lemon-gui/issues",
    "email": "bugs@lemonade.app"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Lemonade-app"
  },
  "keywords": [
    "lemonade",
    "gui",
    "ui",
    "design-system",
    "esm",
    "typescript"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "pnpm@9.1.0+sha256.abcdef...",
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@lemonade/paint":     "github:Lemonade-app/lemon-paint#v1.0.0",
    "@lemonade/blocks":    "github:Lemonade-app/lemon-blocks#v1.0.0",
    "@lemonade/i18n":      "github:Lemonade-app/lemon-i18n#v1.0.0",
    "@lemonade/api":       "github:Lemonade-app/lemon-api#v1.0.0",
    "@lemonade/ux":        "github:Lemonade-app/UX-Designs#v1.0.0",
    "@lemonade/assistant": "github:Lemonade-app/lemonade-ai#v1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "20.11.0",
    "pnpm": "9.1.0"
  }
}